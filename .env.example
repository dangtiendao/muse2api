# ==========================================
# Ví dụ biến môi trường cấu hình cho MUSE2API
# Sao chép thành .env để áp dụng: cp .env.example .env
# ==========================================

# [Bắt buộc/Tùy chọn] Khóa xác thực quản trị và API (bắt đầu bằng m2a_).
# Nếu để trống, chương trình sẽ tự động tạo một khóa ngẫu nhiên độ an toàn cao khi khởi động lần đầu và in ra nhật ký console.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Địa chỉ và cổng lắng nghe của dịch vụ (trong container Docker cần đặt là 0.0.0.0)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Địa chỉ truy cập công khai bên ngoài (dùng cho client kết nối và hiển thị trên trang admin, ví dụ https://api.yourdomain.com)
# Khi để trống, trang quản trị sẽ tự động sử dụng host và cổng mà trình duyệt hiện tại đang truy cập
MUSE2API_PUBLIC_BASE=

# Đường dẫn tới tệp thực thi của trình duyệt Chromium
# Linux/Docker thường là /usr/bin/chromium hoặc /usr/bin/chromium-browser
# Chạy cục bộ trên Windows có thể đặt đường dẫn đầy đủ của Chrome hoặc để trống để tự động tìm kiếm
MUSE2API_CHROMIUM=/usr/bin/chromium

# Cổng giao tiếp gỡ lỗi từ xa qua CDP
MUSE2API_CDP_PORT=19210

# Kiểm soát thời gian timeout của nhiệm vụ (đơn vị: giây)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Số lượng tác vụ sinh nội dung đồng thời tối đa (hỗ trợ điều chỉnh linh hoạt theo tài nguyên máy chủ, mặc định: 2)
MUSE2API_CONCURRENCY=2

# Có tự động giữ phiên (keepalive) cho các tài khoản bị vô hiệu hóa hay không (0=tắt, 1=bật)
# Khi bật, các tài khoản bị tắt vẫn được gia hạn phiên ngầm nhưng không được điều phối tham gia tạo nội dung và hội thoại thông thường
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Công tắc an toàn ảnh tham chiếu (mặc định an toàn; chỉ cân nhắc đặt là 1 khi triển khai môi trường tin cậy một người dùng)
# 1: Cho phép yêu cầu API đọc đường dẫn tệp cục bộ trên máy chủ
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1: Cho phép yêu cầu API tải URL nội bộ/localhost; 0: kiểm tra từng bước chuyển hướng và chỉ cho phép IP công cộng
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0
